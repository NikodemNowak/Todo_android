<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/dimen_20">

    <TextView
        android:id="@+id/catUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="catUrl"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/catId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="catId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/catUrl" />

    <TextView
        android:id="@+id/catWidth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="catWidth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/catId"
        />

    <TextView
        android:id="@+id/catHeight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="catHeight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/catWidth" />

    <Button
        android:id="@+id/loadNewCat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Load new cat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>